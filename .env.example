# MikroTik Ashgabat website concept — local development environment.
# Copy to .env, then run: php artisan key:generate
# Production template: deployment/directadmin/env.production.example
# Never commit .env or put real passwords in this file.

APP_NAME="MikroTik Ashgabat"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8097
# Only when the web root is not ./public (e.g. DirectAdmin public_html):
# APP_PUBLIC_PATH=/home/USER/domains/DOMAIN/public_html
# Product photos use host-relative URLs (/uploads/...). Set this only for a subfolder install or a CDN.
# UPLOADS_URL=/uploads

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MariaDB in Docker (see README "Getting started")
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3310
DB_DATABASE=mikrotik
DB_USERNAME=mikrotik
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Site behaviour (config/site.php) ---
# Contact channels shown until the admin Settings page overrides them.
# The defaults are fictional placeholders; leave the Instagram handle empty to hide it.
SITE_PHONE=+99300000000
SITE_WHATSAPP=99300000000
SITE_INSTAGRAM_HANDLE=
# Keep false while the site is an unapproved concept (noindex + robots Disallow).
SITE_INDEXABLE=false
# Shows the "independent concept, not the official website" footer notice.
SITE_CONCEPT_MODE=true
SITE_CURRENCY=TMT
# Stored inquiries allowed per IP per 10 minutes.
INQUIRY_RATE_LIMIT=5
# Fallback recipient for new-inquiry e-mails (the admin Settings value wins).
INQUIRY_NOTIFY_EMAIL=
# Seeder copies product photos into public/uploads (set false for quick reseeds).
SITE_SEED_IMAGES=true
