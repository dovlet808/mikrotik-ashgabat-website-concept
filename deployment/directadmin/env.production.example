# Production .env for MikroTik Ashgabat on DirectAdmin.
# Copy to the Laravel root as ".env" (outside public_html) and fill in.
# Generate APP_KEY locally with:  php artisan key:generate --show

APP_NAME="MikroTik Ashgabat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.example.com
# Absolute path of the domain's public_html (the web root), so artisan commands
# write uploads and assets to the same place the web server reads them.
APP_PUBLIC_PATH=/home/USER/domains/DOMAIN/public_html

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# DirectAdmin → MySQL Management → create database + user
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# DirectAdmin → E-Mail Accounts; use the hosting SMTP server
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Site behaviour
SITE_PHONE=                 # international format, e.g. +99360000000
SITE_WHATSAPP=              # digits only, with country code
SITE_INSTAGRAM_HANDLE=      # account name without @, or empty to hide the link
SITE_INDEXABLE=false        # keep false while this is an unapproved concept
SITE_CONCEPT_MODE=true      # shows the "independent concept" notice
SITE_CURRENCY=TMT
INQUIRY_RATE_LIMIT=5
INQUIRY_NOTIFY_EMAIL=
